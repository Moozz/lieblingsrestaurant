        "sections": [
          {
            "title": "Pickle the chili (ahead of time)",
            "steps": [
              {
                "text": "Mix sliced yellow chili with garlic and vinegar; pickle ahead of time for the best flavor.",
                "important": false
              }
            ]
          },
          {
            "title": "Cook chicken",
            "steps": [
              {
                "text": "Boil chicken breast with sam-gler powder (pounded cilantro root, garlic, white peppercorn) and salt until cooked through.",
                "important": false
              },
              {
                "text": "Once cool enough to handle, shred the chicken by hand along the grain of the meat.",
                "important": false
              },
              {
                "text": "Render chicken skin in a pan with a little salt until the fat renders out and the skin turns golden and crispy; set skin cracklings aside and reserve the rendered chicken fat/oil. No need to stir constantly — just stir occasionally at the start so the salt mixes in.",
