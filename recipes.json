          },
          {
            "name": "spring onion, sliced",
            "amount": null,
            "unit": null
          },
          {
            "name": "cilantro (sawtooth or regular), sliced",
            "amount": null,
            "unit": null
          }
        ],
        "sections": [
          {
            "title": "Make the sauce",
            "steps": [
              {
                "text": "Combine fish sauce, sugar, and lime juice (or tamarind juice) in a mixing bowl.",
                "important": false
              },
              {
                "text": "Stir until the sugar fully dissolves and blends with the fish sauce and lime juice.",
                "important": false
              },
              {
                "text": "Add roasted chili powder and toasted rice powder, stir to combine.",
                "important": false
              },
              {
                "text": "Taste and adjust for sour, salty, sweet, and spicy balance to your preference.",
                "important": false
              },
              {
                "text": "Add sliced shallot, spring onion, and cilantro; stir gently. Serve alongside grilled pork neck or fried dishes.",
                "important": false
              }
            ]
          }
        ]
